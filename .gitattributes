# Keep text files as LF, no matter the OS.
* text=auto eol=lf

# Shell scripts need LF to run on Linux/macOS.
*.sh text eol=lf

# Binary files: leave line endings alone.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
